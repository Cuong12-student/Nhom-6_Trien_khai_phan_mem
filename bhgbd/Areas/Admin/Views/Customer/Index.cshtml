@model IEnumerable<bhgbd.Models.Customer>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var searchString = ViewBag.SearchString as string;
    var totalCustomers = (int)(ViewBag.TotalCustomers ?? 0);
    var totalOrders = (int)(ViewBag.TotalOrders ?? 0);
    var pendingOrders = (int)(ViewBag.PendingOrders ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-people-fill text-danger me-2"></i>Quản Lý Khách Hàng</h2>
        <p class="text-muted small mb-0">Theo dõi thông tin khách hàng, tìm kiếm nhanh và xem lịch sử mua hàng.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card admin-panel-card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase">Tổng khách hàng</div>
                        <h3 class="fw-bold mb-0">@totalCustomers</h3>
                    </div>
                    <div class="stat-icon card-users"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card admin-panel-card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase">Tổng đơn hàng</div>
                        <h3 class="fw-bold mb-0">@totalOrders</h3>
                    </div>
                    <div class="stat-icon card-orders"><i class="bi bi-receipt"></i></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card admin-panel-card h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small text-uppercase">Đơn chờ duyệt</div>
                        <h3 class="fw-bold mb-0 text-warning">@pendingOrders</h3>
                    </div>
                    <div class="stat-icon card-products"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body bg-white rounded-3 p-3">
        <form asp-area="Admin" asp-controller="Customer" asp-action="Index" method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="searchString" value="@searchString" class="form-control border-start-0" placeholder="Tìm kiếm theo tên, số điện thoại hoặc email..." />
                </div>
            </div>
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100 fw-semibold"><i class="bi bi-search me-1"></i> Tìm Kiếm</button>
                <a asp-area="Admin" asp-controller="Customer" asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3">Mã KH</th>
                        <th>Họ Và Tên</th>
                        <th>Số Điện Thoại</th>
                        <th>Email</th>
                        <th>Địa Chỉ Mặc Định</th>
                        <th>Thông Tin Cá Nhân</th>
                        <th class="text-end pe-3">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy thông tin khách hàng nào.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var c in Model)
                        {
                            // Lấy tên hiển thị ưu tiên customerName -> Username
                            string displayName = !string.IsNullOrWhiteSpace(c.customerName)
                                ? c.customerName
                                : (c.User?.username ?? "Khách hàng mới");

                            <tr>
                                <td class="ps-3 fw-bold text-secondary">#KH-@c.customerId</td>
                                <td>
                                    <div class="fw-bold text-dark">@displayName</div>
                                    <small class="text-muted"><i class="bi bi-person me-1"></i>Username: @(c.User?.username ?? "Chưa rõ")</small>
                                </td>
                                <td class="fw-semibold text-primary">
                                    @(string.IsNullOrWhiteSpace(c.phone) ? "Chưa cập nhật" : c.phone)
                                </td>
                                <td class="text-muted">
                                    @(string.IsNullOrWhiteSpace(c.email) ? "Chưa cập nhật" : c.email)
                                </td>
                                <td class="text-muted text-truncate" style="max-width: 220px;">
                                    @(string.IsNullOrWhiteSpace(c.address) ? "Chưa cập nhật" : c.address)
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(c.gender.ToString() ?? "Nam"), @(c.age > 0 ? c.age : 20) tuổi
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <button class="btn btn-sm btn-outline-danger fw-semibold"
                                            onclick="viewOrderHistory(@c.customerId, '@displayName')">
                                        <i class="bi bi-receipt me-1"></i> Xem Lịch Sử Đơn Hàng
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="orderHistoryModal" tabindex="-1" aria-labelledby="orderHistoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title fw-bold" id="orderHistoryModalTitle"><i class="bi bi-clock-history me-2"></i>Lịch Sử Mua Hàng</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div id="orderHistoryLoading" class="text-center py-4">
                    <div class="spinner-border text-danger" role="status">
                        <span class="visually-hidden">Đang tải...</span>
                    </div>
                    <p class="text-muted mt-2 small">Đang tải lịch sử giao dịch...</p>
                </div>
                <div id="orderHistoryContainer" class="table-responsive" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function viewOrderHistory(customerId, customerName) {
            document.getElementById('orderHistoryModalTitle').innerHTML = '<i class="bi bi-clock-history me-2"></i>Lịch Sử Mua Hàng - ' + customerName;

            var loading = document.getElementById('orderHistoryLoading');
            var container = document.getElementById('orderHistoryContainer');

            loading.style.display = 'block';
            container.style.display = 'none';

            var modal = new bootstrap.Modal(document.getElementById('orderHistoryModal'));
            modal.show();

            fetch('/Admin/Customer/GetCustomerOrders?customerId=' + customerId)
                .then(response => response.json())
                .then(data => {
                    loading.style.display = 'none';
                    container.style.display = 'block';

                    if (!data || data.length === 0) {
                        container.innerHTML = '<div class="p-4 text-center text-muted"><i class="bi bi-inbox fs-1 d-block mb-2"></i>Khách hàng này chưa thực hiện đơn hàng nào.</div>';
                    } else {
                        var html = '<table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Mã Đơn</th><th>Người Nhận</th><th>Số Điện Thoại</th><th>Ngày Đặt</th><th>Tổng Tiền</th><th>Trạng Thái</th></tr></thead><tbody>';
                        data.forEach(function (o) {
                            var dateStr = new Date(o.orderDate).toLocaleDateString('vi-VN');
                            var totalFormatted = new Intl.NumberFormat('vi-VN').format(o.total) + ' đ';

                            var statusBadge = '<span class="badge bg-secondary">' + o.status + '</span>';
                            if (o.status === 'Pending') statusBadge = '<span class="badge bg-warning text-dark">Chờ duyệt</span>';
                            else if (o.status === 'Confirmed') statusBadge = '<span class="badge bg-success">Đã duyệt</span>';
                            else if (o.status === 'Cancelled') statusBadge = '<span class="badge bg-dark">Đã hủy</span>';
                            else if (o.status === 'CancelRequested') statusBadge = '<span class="badge bg-danger">Yêu cầu hủy</span>';

                            html += '<tr><td class="fw-bold">#DH-' + o.orderId + '</td><td>' + o.receiverName + '</td><td>' + o.receiverPhone + '</td><td>' + dateStr + '</td><td class="fw-bold text-danger">' + totalFormatted + '</td><td>' + statusBadge + '</td></tr>';
                        });
                        html += '</tbody></table>';
                        container.innerHTML = html;
                    }
                })
                .catch(err => {
                    loading.style.display = 'none';
                    container.style.display = 'block';
                    container.innerHTML = '<div class="p-4 text-center text-danger">Có lỗi xảy ra khi tải lịch sử đơn hàng.</div>';
                });
        }
    </script>
}