@using bhgbd.Models
@{
    ViewData["Title"] = "Báo cáo Tổng quan";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var totalRevenue = (decimal)ViewBag.TotalRevenue;
    var totalOrders = (int)ViewBag.TotalOrders;
    var ordersToday = (int)ViewBag.OrdersToday;
    var totalProducts = (int)ViewBag.TotalProducts;
    var totalCustomers = (int)ViewBag.TotalCustomers;
    var totalStaff = (int)ViewBag.TotalStaff;
    var recentOrders = ViewBag.RecentOrders as List<Order> ?? new List<Order>();
    var statusCounts = ViewBag.StatusCounts as Dictionary<string, int> ?? new Dictionary<string, int>();
    var pendingCount = statusCounts.ContainsKey("Pending") ? statusCounts["Pending"] : 0;
    var confirmedCount = statusCounts.ContainsKey("Confirmed") ? statusCounts["Confirmed"] : 0;
    var cancelRequestedCount = statusCounts.ContainsKey("CancelRequested") ? statusCounts["CancelRequested"] : 0;
    var cancelledCount = statusCounts.ContainsKey("Cancelled") ? statusCounts["Cancelled"] : 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-speedometer2 text-danger me-2"></i>Báo Cáo Tổng Quan</h2>
        <p class="text-muted small mb-0">Theo dõi doanh thu, đơn hàng và hoạt động quản trị của hệ thống BHGBD.</p>
    </div>
    <span class="badge bg-white text-dark border p-2"><i class="bi bi-calendar3 me-1"></i> Hôm nay: @DateTime.Now.ToString("dd/MM/yyyy")</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Tổng Doanh Thu</span>
                    <h3 class="fw-bold text-success my-1">@totalRevenue.ToString("N0") <small class="fs-6">đ</small></h3>
                    <small class="text-muted"><i class="bi bi-check-circle-fill text-success me-1"></i>Đã trừ đơn hủy</small>
                </div>
                <div class="stat-icon card-revenue"><i class="bi bi-cash-stack"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Tổng Đơn Hàng</span>
                    <h3 class="fw-bold text-primary my-1">@totalOrders</h3>
                    <small class="text-primary fw-medium"><i class="bi bi-arrow-up-right me-1"></i>@ordersToday đơn trong hôm nay</small>
                </div>
                <div class="stat-icon card-orders"><i class="bi bi-cart-check-fill"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Sản Phẩm Hiện Có</span>
                    <h3 class="fw-bold text-warning my-1">@totalProducts</h3>
                    <small class="text-muted"><i class="bi bi-box-seam me-1"></i>Sẵn sàng bán</small>
                </div>
                <div class="stat-icon card-products"><i class="bi bi-shoe"></i></div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card h-100 p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted fw-semibold small text-uppercase">Khách & Nhân Viên</span>
                    <h3 class="fw-bold my-1" style="color: #6f42c1;">@totalCustomers <small class="fs-6 text-muted">/ @totalStaff NV</small></h3>
                    <small class="text-muted"><i class="bi bi-people me-1"></i>@totalCustomers Khách hàng</small>
                </div>
                <div class="stat-icon card-users"><i class="bi bi-people-fill"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0 fw-bold">
                <i class="bi bi-pie-chart-fill text-danger me-2"></i>Thống kê theo Trạng Thái Đơn Hàng
            </div>
            <div class="card-body d-flex justify-content-center align-items-center">
                <canvas id="orderStatusChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark"><i class="bi bi-clock-history text-danger me-2"></i>Đơn Hàng Mới Nhất</span>
                <span class="badge bg-secondary">Top 10 đơn gần đây</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Khách hàng</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th>Ngày đặt</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!recentOrders.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">Chưa có đơn hàng nào trong hệ thống.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var o in recentOrders)
                                {
                                    <tr>
                                        <td class="fw-bold">#DH-@o.orderId</td>
                                        <td>
                                            <div class="fw-semibold">@(o.Customer?.customerName ?? o.receiverName)</div>
                                            <small class="text-muted">@o.receiverPhone</small>
                                        </td>
                                        <td class="fw-bold text-danger">@o.total.ToString("N0") đ</td>
                                        <td>
                                            @switch (o.status)
                                            {
                                                case OrderStatus.Pending:
                                                    <span class="badge badge-status badge-pending">Chờ duyệt</span>
                                                    break;
                                                case OrderStatus.Confirmed:
                                                    <span class="badge badge-status badge-confirmed">Đã duyệt</span>
                                                    break;
                                                case OrderStatus.CancelRequested:
                                                    <span class="badge badge-status badge-cancel-req">Yêu cầu hủy</span>
                                                    break;
                                                case OrderStatus.Cancelled:
                                                    <span class="badge badge-status badge-cancelled">Đã hủy</span>
                                                    break;
                                            }
                                        </td>
                                        <td><small class="text-muted">@o.orderDate.ToString("dd/MM/yyyy HH:mm")</small></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ctx = document.getElementById('orderStatusChart').getContext('2d');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Đã duyệt', 'Chờ duyệt', 'Yêu cầu hủy', 'Đã hủy'],
                datasets: [{
                    data: [@confirmedCount, @pendingCount, @cancelRequestedCount, @cancelledCount],
                    backgroundColor: ['#198754', '#ffc107', '#dc3545', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
}
