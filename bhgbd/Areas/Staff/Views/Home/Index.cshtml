@model IEnumerable<bhgbd.Models.Order>
@{
    ViewData["Title"] = "Trang chủ Nhân viên";
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Ca làm việc - Dashboard</h2>
            <p class="text-muted small m-0">Chào mừng bạn trở lại! Dưới đây là tổng quan công việc hôm nay.</p>
        </div>
        <div>
            <a asp-area="Staff" asp-controller="Order" asp-action="Index" class="btn btn-primary fw-bold shadow-sm">
                <i class="bi bi-box-seam me-1"></i> Quản lý Đơn hàng
            </a>
        </div>
    </div>

    <!-- Stat Cards (Dữ liệu đếm động từ ViewBag) -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm border-start border-4 border-warning h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold text-uppercase small">Chờ duyệt (Gấp)</span>
                        <h3 class="fw-bold text-warning mb-0 mt-1">@(ViewBag.PendingCount ?? 0)</h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                        <i class="bi bi-clock-history fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm border-start border-4 border-danger h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold text-uppercase small">Yêu cầu hủy</span>
                        <h3 class="fw-bold text-danger mb-0 mt-1">@(ViewBag.CancelRequestedCount ?? 0)</h3>
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                        <i class="bi bi-x-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm border-start border-4 border-success h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted fw-bold text-uppercase small">Đã duyệt (Chờ giao)</span>
                        <h3 class="fw-bold text-success mb-0 mt-1">@(ViewBag.ConfirmedCount ?? 0)</h3>
                    </div>
                    <div class="bg-success bg-opacity-10 p-3 rounded-circle text-success">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Đơn hàng mới nhất động -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom-0">
            <h5 class="fw-bold m-0 text-dark"><i class="bi bi-list-stars text-primary me-2"></i>Đơn hàng vừa phát sinh</h5>
            <a asp-area="Staff" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Người nhận</th>
                        <th>Số điện thoại</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào phát sinh.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#ORD-@order.orderId</td>
                                <td>@order.orderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.receiverName</td>
                                <td>@order.receiverPhone</td>
                                <td class="fw-bold">@order.total.ToString("N0") đ</td>
                                <td>
                                    @if (order.status == bhgbd.Models.OrderStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                    }
                                    else if (order.status == bhgbd.Models.OrderStatus.CancelRequested)
                                    {
                                        <span class="badge bg-danger px-2 py-1">Yêu cầu hủy</span>
                                    }
                                    else if (order.status == bhgbd.Models.OrderStatus.Confirmed)
                                    {
                                        <span class="badge bg-success px-2 py-1">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-2 py-1">@order.status</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <a asp-area="Staff" asp-controller="Order" asp-action="Detail" asp-route-id="@order.orderId" class="btn btn-sm btn-light border">
                                            <i class="bi bi-eye"></i> Xem
                                        </a>

                                        @if (order.status == bhgbd.Models.OrderStatus.Pending)
                                        {
                                            <form asp-area="Staff" asp-controller="Home" asp-action="ApproveOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.orderId" />
                                                <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Duyệt</button>
                                            </form>
                                        }
                                        else if (order.status == bhgbd.Models.OrderStatus.CancelRequested)
                                        {
                                            <form asp-area="Staff" asp-controller="Home" asp-action="ConfirmCancel" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.orderId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i> Xử lý hủy</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>