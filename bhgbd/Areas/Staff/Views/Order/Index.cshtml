@model IEnumerable<bhgbd.Models.Order>
@{
    ViewData["Title"] = "Quản lý Đơn hàng";
    Layout = "~/Areas/Staff/Views/Shared/_Layout.cshtml";
    string currentFilter = ViewBag.CurrentFilter as string ?? "All";
    string searchString = ViewBag.SearchString as string ?? "";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold text-dark m-0">Quản lý Đơn hàng</h2>
    </div>

    <!-- Filter Tabs & Search Bar Card -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center justify-content-between">
                <!-- Filter Tabs -->
                <div class="col-12 col-lg-8">
                    <ul class="nav nav-pills gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(currentFilter == "All" ? "active fw-bold" : "text-dark")"
                               href="@Url.Action("Index", "Order", new { area = "Staff", statusFilter = "All", searchString })">
                                Tất cả (@(ViewBag.AllCount ?? 0))
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentFilter == "Pending" ? "active fw-bold" : "text-dark") position-relative"
                               href="@Url.Action("Index", "Order", new { area = "Staff", statusFilter = "Pending", searchString })">
                                Chờ duyệt
                                <span class="badge rounded-pill bg-warning text-dark">@(ViewBag.PendingCount ?? 0)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentFilter == "Confirmed" ? "active fw-bold" : "text-dark")"
                               href="@Url.Action("Index", "Order", new { area = "Staff", statusFilter = "Confirmed", searchString })">
                                Đã duyệt (@(ViewBag.ConfirmedCount ?? 0))
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentFilter == "CancelRequested" ? "active fw-bold" : "text-dark") position-relative"
                               href="@Url.Action("Index", "Order", new { area = "Staff", statusFilter = "CancelRequested", searchString })">
                                Yêu cầu hủy
                                <span class="badge rounded-pill bg-danger">@(ViewBag.CancelReqCount ?? 0)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentFilter == "Cancelled" ? "active fw-bold" : "text-dark")"
                               href="@Url.Action("Index", "Order", new { area = "Staff", statusFilter = "Cancelled", searchString })">
                                Đã hủy (@(ViewBag.CancelledCount ?? 0))
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Search Box -->
                <div class="col-12 col-lg-4">
                    <form method="get" action="@Url.Action("Index", "Order", new { area = "Staff" })">
                        <input type="hidden" name="statusFilter" value="@currentFilter" />
                        <div class="input-group">
                            <input type="text" name="searchString" value="@searchString" class="form-control" placeholder="Tìm theo Mã đơn, Tên, SĐT..." />
                            <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Table -->
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Người nhận</th>
                        <th>SĐT</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Không tìm thấy đơn hàng nào.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">#ORD-@order.orderId</td>
                                <td>@order.orderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.receiverName</td>
                                <td>@order.receiverPhone</td>
                                <td class="fw-bold">@order.total.ToString("N0") đ</td>
                                <td>
                                    @if (order.status == bhgbd.Models.OrderStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark fs-6 font-monospace">Chờ duyệt</span>
                                    }
                                    else if (order.status == bhgbd.Models.OrderStatus.CancelRequested)
                                    {
                                        <span class="badge bg-danger fs-6 font-monospace">Yêu cầu hủy</span>
                                    }
                                    else if (order.status == bhgbd.Models.OrderStatus.Confirmed)
                                    {
                                        <span class="badge bg-success fs-6 font-monospace">Đã duyệt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6 font-monospace">@order.status</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        <a asp-area="Staff" asp-controller="Order" asp-action="Detail" asp-route-id="@order.orderId" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Chi tiết
                                        </a>

                                        @if (order.status == bhgbd.Models.OrderStatus.Pending)
                                        {
                                            <form asp-area="Staff" asp-controller="Order" asp-action="ApproveOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.orderId" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-check-circle"></i> Duyệt đơn
                                                </button>
                                            </form>
                                        }
                                        else if (order.status == bhgbd.Models.OrderStatus.CancelRequested)
                                        {
                                            <form asp-area="Staff" asp-controller="Order" asp-action="AcceptCancelOrder" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="orderId" value="@order.orderId" />
                                                <button type="submit" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-arrow-return-left"></i> Chấp nhận hủy
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>