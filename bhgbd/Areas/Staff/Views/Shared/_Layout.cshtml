@using System.Text.Encodings.Web
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhân Viên BHGBD</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/Staff.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">

    <!-- HEADER NHÂN VIÊN -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top border-bottom border-info border-3">
        <div class="container-fluid px-4">
            <a class="navbar-brand fw-bold text-info fs-4" asp-area="Staff" asp-controller="Home" asp-action="Index">
                <i class="bi bi-person-workspace me-2"></i>ShoesShop STAFF
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#staffNavbar" aria-controls="staffNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="staffNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link text-light fw-semibold" asp-area="Staff" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2 me-1"></i> Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-light fw-semibold" asp-area="Staff" asp-controller="Order" asp-action="Index">
                            <i class="bi bi-box-seam-fill me-1"></i> Quản lý Đơn hàng
                        </a>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-light small"><i class="bi bi-person-badge me-1"></i> Nhân viên ca trực</span>
                    <a class="btn btn-outline-info btn-sm text-white" asp-area="" asp-controller="Auth" asp-action="Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- NỘI DUNG NHÂN VIÊN -->
    <main class="container-fluid px-4 my-4 flex-grow-1">
        @RenderBody()
    </main>

    <!-- FOOTER NHÂN VIÊN -->
    <footer class="bg-dark text-white py-3 mt-auto border-top border-secondary">
        <div class="container-fluid text-center">
            <small class="text-muted">© 2026 ShoesShop </small>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>