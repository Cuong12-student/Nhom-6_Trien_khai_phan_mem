@page
@model bhgbd.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ShoesShop</title>
    <link rel="stylesheet" href="~/css/auth.css" />
</head>
<body>

    <header class="site-header">
        <a href="/" class="brand">
            <span class="logo-box">👟</span>
            ShoesShop
            <span class="page-label">Đăng nhập</span>
        </a>
        <a href="javascript:void(0)" class="help-link" onclick="openAuthModal('modal-help')">Bạn cần giúp đỡ?</a>
    </header>

    <div class="auth-banner">
        <div class="auth-banner-inner">

            <div class="auth-card-float">
                <h2 class="auth-title">Đăng nhập</h2>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-alert auth-alert-error">
                        @Model.ErrorMessage
                    </div>
                }

                <form method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="auth-alert auth-alert-error"></div>

                    <div class="form-group">
                        <label asp-for="Input.UsernameOrEmail"></label>
                        <input asp-for="Input.UsernameOrEmail" class="form-control" placeholder="Nhập Username hoặc Email" autocomplete="username" />
                        <span asp-validation-for="Input.UsernameOrEmail" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password"></label>
                        <input asp-for="Input.Password" class="form-control" placeholder="Mật khẩu" autocomplete="current-password" />
                        <span asp-validation-for="Input.Password" class="field-error"></span>
                    </div>

                    <div class="form-row-between">
                        <label class="checkbox-label">
                            <input asp-for="Input.RememberMe" />
                            <span>Duy trì đăng nhập</span>
                        </label>
                        <a href="#" class="auth-link">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn-primary">ĐĂNG NHẬP</button>
                </form>

                <div class="auth-divider">HOẶC</div>

                <div class="social-buttons">
                    <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="btn-social">Facebook</a>
                    <a href="https://accounts.google.com/signin/v2/usernamerecovery?hl=vi&flowName=GlifWebSignIn&flowEntry=ServiceLogin" target="_blank" rel="noopener noreferrer" class="btn-social">Google</a>
                </div>

                <p class="auth-terms">
                    Bằng việc đăng nhập, bạn đồng ý với
                    <a href="javascript:void(0)" class="auth-link" onclick="openAuthModal('modal-terms')">Điều khoản dịch vụ</a> &amp;
                    <a href="javascript:void(0)" class="auth-link" onclick="openAuthModal('modal-privacy')">Chính sách bảo mật</a>
                </p>

                <p class="auth-footer">
                    Bạn mới biết đến ShoesShop?
                    <a asp-page="/Auth/Register" class="auth-link">Đăng ký</a>
                </p>
            </div>

        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />
    <partial name="_TermsModals" />
    <partial name="HelpModal" />
</body>
</html>
